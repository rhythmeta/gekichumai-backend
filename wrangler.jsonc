{
  "$schema": "node_modules/wrangler/config-schema.json",
  "alias": {
    "@serenity-kit/opaque": "./.worker-vendor/opaque.js",
  },
  "name": "gekichumai-backend",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // api.rhythmeta.org/* is an existing zone route managed separately.
  // Omitting routes lets application deploys retain it without Zone Routes permission.
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rhythmeta",
      "database_id": "8cf164dd-0277-4860-ba58-595ed35df784",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "gekichumai-backups",
    },
  ],
  "triggers": {
    "crons": ["* * * * *"],
  },
  "account_id": "10dabe832f43634059930effbc08f01e",
}
