{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": [
      "@cloudflare/workers-types",
      "node",
      "vitest/globals"
    ],
    "noEmit": true
  },
  "include": [
    "src",
    "test",
    "vitest.config.ts"
  ]
}
