{
  "name": "rhythmeta-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run prepare:worker && wrangler dev",
    "build": "pnpm run prepare:worker && pnpm run openapi:build && tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply rhythmeta --local",
    "db:migrate:remote": "wrangler d1 migrations apply rhythmeta --remote",
    "migrate:backup": "python3 scripts/import-postgres-backup.py",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "openapi:build": "tsx scripts/generate-openapi.ts",
    "prepare:worker": "node scripts/prepare-opaque-worker.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.908.0",
    "@aws-sdk/s3-request-presigner": "^3.908.0",
    "@hono/standard-validator": "^0.2.2",
    "@scalar/hono-api-reference": "^0.10.5",
    "@serenity-kit/opaque": "1.1.0",
    "@simplewebauthn/server": "^12.0.0",
    "@standard-schema/spec": "^1.1.0",
    "bcryptjs": "^3.0.2",
    "hono": "^4.9.8",
    "jose": "^6.1.0",
    "otpauth": "^9.4.1",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "typescript": "^5.9.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "miniflare": "5.20260930.0-alpha",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript-eslint": "^8.46.1",
    "vitest": "^3.2.4",
    "wrangler": "4.145.0"
  },
  "packageManager": "pnpm@10.28.2"
}
